# Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Sheets ID (the long ID in the Google Sheet URL)
# e.g. https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Sheet worksheet name (tab name)
GOOGLE_SHEET_WORKSHEET=Sheet1

# Google Drive Folder ID (the ID in the Google Drive folder URL)
# e.g. https://drive.google.com/drive/folders/THIS_IS_THE_ID
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Path to Google Service Account credentials JSON file
GOOGLE_CREDENTIALS_FILE=credentials/service_account.json

# Allowed Telegram user IDs (comma-separated, for security)
# Find your user ID by messaging @userinfobot on Telegram
ALLOWED_USER_IDS=
